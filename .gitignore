# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files
.env*.local
.env

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Scanner backend
scanner/

# Data files
threatfox.json

# Dev scripts (one-time migration helpers)
# NOTE: pattern is scripts/* (not scripts/) so the negation below can work —
# git cannot re-include a file whose parent directory is itself excluded.
scripts/*
# ...except build-globe.mjs: a permanent, required build step (regenerates
# public/globe from the vendored God's Eye View client), not a one-time
# migration helper. Keep tracked.
!scripts/build-globe.mjs

# AI agent config files
# CLAUDE.md is deliberately TRACKED here, unlike upstream: it is the install
# and operating guide a Claude session reads on any machine.
# CLAUDE.md
AGENTS.md

# Internal dev notes
DO_NOT_PUSH.md
implementation_plan.md

# Security - prevent accidental backup commits
scanner_backend_backup.js

# Security - Prevent accidental manual leaks
*Manual*.md

# OASIS VISION launcher runtime - never commit these.
# .appwindow is the app window's Chrome profile: cookies, cache, history.
launcher/.appwindow/
launcher/logs/
launcher/*.ico

# GEV route disk caches (Overpass, CelesTrak, terrain heights)
.oasis-cache/
