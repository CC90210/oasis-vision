diff --git a/src/logoGaze.js b/src/logoGaze.js
index c925083..a5300a2 100644
--- a/src/logoGaze.js
+++ b/src/logoGaze.js
@@ -86,9 +86,20 @@ export function initLogoGaze(root = document) {
     if (!animationFrame) animationFrame = window.requestAnimationFrame(animate);
   };
 
+  const resolveLogoSrc = (raw) => {
+    // The markup's data-logo-src is always set (index.html hardcodes
+    // '/logo.svg'), so this can never be trusted as-is: normalise it
+    // instead of falling back only when it's empty. A root-absolute value
+    // is resolved against Vite's injected BASE_URL (which already carries
+    // its trailing slash), so it still resolves correctly under a subpath
+    // base like /globe/ regardless of what the HTML attribute says.
+    const value = raw || 'logo.svg';
+    return value.startsWith('/') ? `${import.meta.env.BASE_URL}${value.slice(1)}` : value;
+  };
+
   const loadInlineLogos = async () => {
     try {
-      const source = logos[0].dataset.logoSrc || '/logo.svg';
+      const source = resolveLogoSrc(logos[0].dataset.logoSrc);
       const response = await window.fetch(source);
       if (!response.ok) return;
       const markup = await response.text();
